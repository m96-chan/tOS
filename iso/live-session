#!/bin/sh
# shellcheck shell=dash
# The tOS session: the environment the compositor runs in, and the loop that
# keeps it running.
#
# This file is on the image twice and in the tree once. /init execs it as PID 1
# after pivoting into the Debian rootfs, and execs the initramfs copy when
# there was no rootfs to pivot into. Both sides need the same environment and
# the same rescue rule; leaving the loop in /init and writing it out again for
# the rootfs is how the two would come to disagree about which one locks.
#
# An installed machine does not run this: busybox init reads the inittab the
# installer wrote and respawns /etc/tos-session, which the installer writes
# from installer/src/install.rs. The restart loop below is init's job there.

# PID 1's own stdout is whichever console= came last on the kernel command
# line, and the machine may have several. Anything a person needs to read goes
# to all of them: a screen is the usual one, a serial line is what CI and
# anyone debugging a headless boot captures.
say() {
    said=
    for tty in /dev/tty0 /dev/ttyS0; do
        [ -c "$tty" ] && { echo "$@" >"$tty"; } 2>/dev/null && said=1
    done
    [ -n "$said" ] || echo "$@"
}

# The machine's name, which nothing else in a live session sets: the installed
# machine gets it from /etc/rc, and without it here the kernel hostname stays
# `(none)` and every prompt in every pane says so.
[ -r /etc/hostname ] && hostname -F /etc/hostname 2>/dev/null

export HOME=/root
# Whose session this is, and so whose /etc/shadow line the screen lock asks
# for (#111). Root's, here: nobody has been asked who they are, and a live
# image has no account but the one Debian ships. Debian's root carries `*`
# rather than a hash, so by the rule in docs/design/screen-lock.md the live
# session has nothing to lock with and never locks — which is what it did
# before this line existed, and now says so rather than arriving there by
# having no credential file at all. The installer writes the same variable
# into /etc/tos-session, naming the person it was told about.
export TOS_USER=root
# bash where the filesystem has one, /bin/sh where it does not. The Debian
# rootfs has bash and /bin/sh there is dash; the initramfs rescue session has
# neither, only busybox ash. This file runs as PID 1 on both sides, so it asks
# rather than assuming — and what it finds decides the line below it too.
if [ -x /bin/bash ]; then
    SHELL=/bin/bash
else
    SHELL=/bin/sh
fi
export SHELL
export TERM=xterm-256color
export TOS=1
# ENV is how the message of the day reaches a pane whose shell is ash or dash:
# both read it for every interactive shell. bash does not — it reads ENV only
# when it is invoked as `sh` — so where bash is the shell the counterpart is
# /root/.bashrc, and iso/bashrc is what mkiso.sh installs as one.
#
# Exported either way rather than only where the shell is not bash: tos.conf's
# `shell =` and the compositor's -e change the program a pane runs without
# changing $SHELL, so a machine that pointed either at dash would have a pane
# that reads neither this nor ~/.bashrc, and the banner would be gone. bash
# does no harm carrying a variable it never reads.
export ENV=/etc/profile
# Debian's own order, and /sbin before /bin matters on both sides of the pivot:
# the initramfs has util-linux's mount in /sbin and busybox's in /bin, and only
# the first of those can mount a filesystem by label.
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# The emergency shell is a rescue tool, and a rescue tool on a machine that
# somebody else is standing at is an unauthenticated root shell on the screen
# they were locked out of. The live image asks for it by name, because it has
# no credential and so by the rule in docs/design/screen-lock.md never locks;
# an installed machine that needs one adds the word at the GRUB prompt. See
# docs/design/lock-other-doors.md.
rescue=
if [ -r /proc/cmdline ]; then
    read -r cmdline </proc/cmdline
    case " $cmdline " in
    *" tos.rescue "*) rescue=1 ;;
    esac
fi

say "tOS: starting compositor"
restarts=0
while :; do
    /sbin/tos
    status=$?
    if [ -n "$rescue" ]; then
        say "tOS: compositor exited ($status), dropping to emergency shell"
        exec sh
    fi
    if [ "$restarts" -eq 0 ]; then
        say "tOS: add tos.rescue to the kernel command line for a shell"
    fi
    restarts=$((restarts + 1))
    say "tOS: compositor exited ($status), restarting"
    sleep 1
done
