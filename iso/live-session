#!/bin/sh
# shellcheck shell=dash
# The tOS session: the environment the compositor runs in, and what to do when
# it exits.
#
# This file is on the image twice and in the tree once, and it is what every
# tOS session is started by:
#
#   live medium      /init pivots into the Debian rootfs and execs systemd,
#                    whose tos-session.service runs this as /sbin/tos-session
#   installed disk   the same rootfs on a disk, the same unit, with a drop-in
#                    that names the person the installer was told about
#   no rootfs        /init execs the initramfs copy of this file as PID 1,
#                    which is the rescue session and has no init at all
#
# The environment is the same on all three, which is the reason it is one file:
# it used to be written out a second time by the installer, and the two copies
# drifted by a TERM and a PATH. The last of the three is the only one where
# this is PID 1, and the only one where the restart loop at the bottom runs —
# everywhere else systemd is what starts it again, and asking to be restarted
# is how this says so.

# PID 1's own stdout is whichever console= came last on the kernel command
# line, and the machine may have several. Anything a person needs to read goes
# to all of them: a screen is the usual one, a serial line is what CI and
# anyone debugging a headless boot captures.
say() {
    said=
    for tty in /dev/tty0 /dev/ttyS0; do
        [ -c "$tty" ] && { echo "$@" >"$tty"; } 2>/dev/null && said=1
    done
    [ -n "$said" ] || echo "$@"
}

# The machine's name. systemd sets it from this same file long before the
# session starts, so on the two paths that have an init this changes nothing;
# it is here for the rescue session, which has no init, and where without it
# the kernel hostname stays `(none)` and every prompt in every pane says so.
[ -r /etc/hostname ] && hostname -F /etc/hostname 2>/dev/null

export HOME=/root
# Whose session this is, and so whose /etc/shadow line the screen lock asks
# for (#111). Root unless something said otherwise, which is the live image
# and the rescue session: nobody has been asked who they are, and the image
# has no account but the one Debian ships. Debian's root carries `*` rather
# than a hash, so by the rule in docs/design/screen-lock.md such a session has
# nothing to lock with and never locks.
#
# An installed machine is somebody's, and says so through the unit: the
# installer writes a tos-session.service drop-in with Environment=TOS_USER
# naming the person. Defaulted rather than assigned, so that the drop-in is
# not overwritten by the script it configures.
: "${TOS_USER:=root}"
export TOS_USER
# bash where the filesystem has one, /bin/sh where it does not. The Debian
# rootfs has bash and /bin/sh there is dash; the initramfs rescue session has
# neither, only busybox ash. This file runs as PID 1 on both sides, so it asks
# rather than assuming — and what it finds decides the line below it too.
if [ -x /bin/bash ]; then
    SHELL=/bin/bash
else
    SHELL=/bin/sh
fi
export SHELL
export TERM=xterm-256color
export TOS=1
# ENV is how the message of the day reaches a pane whose shell is ash or dash:
# both read it for every interactive shell. bash does not — it reads ENV only
# when it is invoked as `sh` — so where bash is the shell the counterpart is
# /root/.bashrc, and iso/bashrc is what mkiso.sh installs as one.
#
# Exported either way rather than only where the shell is not bash: tos.conf's
# `shell =` and the compositor's -e change the program a pane runs without
# changing $SHELL, so a machine that pointed either at dash would have a pane
# that reads neither this nor ~/.bashrc, and the banner would be gone. bash
# does no harm carrying a variable it never reads.
export ENV=/etc/profile
# Debian's own order, and /sbin before /bin matters on both sides of the pivot:
# the initramfs has util-linux's mount in /sbin and busybox's in /bin, and only
# the first of those can mount a filesystem by label.
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# The emergency shell is a rescue tool, and a rescue tool on a machine that
# somebody else is standing at is an unauthenticated root shell on the screen
# they were locked out of. The live image asks for it by name, because it has
# no credential and so by the rule in docs/design/screen-lock.md never locks;
# an installed machine that needs one adds the word at the GRUB prompt. See
# docs/design/lock-other-doors.md.
rescue=
if [ -r /proc/cmdline ]; then
    read -r cmdline </proc/cmdline
    case " $cmdline " in
    *" tos.rescue "*) rescue=1 ;;
    esac
fi

say "tOS: starting compositor"
restarts=0
while :; do
    /sbin/tos
    status=$?
    if [ -n "$rescue" ]; then
        say "tOS: compositor exited ($status), dropping to emergency shell"
        exec sh
    fi
    if [ "$restarts" -eq 0 ]; then
        say "tOS: add tos.rescue to the kernel command line for a shell"
    fi
    # Where there is an init, leaving is how a service asks to be started
    # again: tos-session.service is Restart=always, and a loop here as well
    # would be a second mechanism doing the same job — with `systemctl status`
    # reporting a session that has never restarted while it restarted all day.
    # PID 1 is the one case with nothing above it to ask, and that is the
    # rescue session out of the initramfs.
    if [ "$$" -ne 1 ]; then
        say "tOS: compositor exited ($status), asking init to start it again"
        exit "$status"
    fi
    restarts=$((restarts + 1))
    say "tOS: compositor exited ($status), restarting"
    sleep 1
done
